# {{ ansible_managed }}
[DEFAULT]
ignoreip = {{ (['127.0.0.1/8', '::1'] + baseline_fail2ban_ignoreip) | join(' ') }}

[sshd]
enabled  = true
port     = {{ baseline_ssh_port }}
backend  = systemd
maxretry = {{ baseline_fail2ban_maxretry }}
findtime = {{ baseline_fail2ban_findtime }}
bantime  = {{ baseline_fail2ban_bantime }}
